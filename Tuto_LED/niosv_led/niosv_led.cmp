	component niosv_led is
		port (
			clk_clk        : in  std_logic                    := 'X'; -- clk
			led_pio_export : out std_logic_vector(3 downto 0);        -- export
			pb_pio_export  : in  std_logic                    := 'X'; -- export
			reset_reset_n  : in  std_logic                    := 'X'  -- reset_n
		);
	end component niosv_led;

